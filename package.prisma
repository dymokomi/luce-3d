#prisma 4.0
def package "luce-3d" {
    str owner = "dymokomi"
    str version = "0.2.0"
    str kind = "package"
    str language = "luce-base"
    str description = "A Luce Base library for scenes, geometry, materials, cameras and rendering through standard gpu. The public names follow the shape of Three.js. It has no UI dependency: an application hosts the renderer in its own view. All platform resources belong to the standard library."
    str readme = "README.md"

    def export "three" {
        str module = "luce_3d.graphics"
    }

    def dependency "luce-std" {
        str owner = "dymokomi"
        str version = "^0.1.0"
        str path = "../luce-std"
    }

    def dependency "luce-gpu" {
        str owner = "dymokomi"
        str version = "^0.1.19"
        str path = "../luce-gpu"
    }
}
