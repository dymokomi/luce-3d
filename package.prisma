#prisma 4.0
def package "luce-3d" {
    str owner = "dymokomi"
    str version = "0.6.2"
    str kind = "package"
    str language = "luce-base"
    str description = "Scenes, geometry, materials, cameras and rendering through standard gpu, in Luce Base, with names shaped like Three.js. No UI dependency: the application hosts the renderer in its own view."
    str readme = "README.md"
    str[] public = ["graphics"]

    def dependency "luce-geocore" {
        str owner = "dymokomi"
        str version = "^0.4.2"
        str path = "../luce-geocore"
    }

    def dependency "luce-std" {
        str owner = "dymokomi"
        str version = "^0.3.1"
        str path = "../luce-std"
    }

    def dependency "luce-gpu" {
        str owner = "dymokomi"
        str version = "^0.2.2"
        str path = "../luce-gpu"
    }
}
