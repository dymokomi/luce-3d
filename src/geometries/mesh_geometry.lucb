## The per-vertex Geometry of a geocore Mesh, for the renderer's path without
## a GPU device (the device path draws a Mesh's arrays; see Mesh.of). Each
## vertex is a corner: its point, shading normal, uv and color.
import interop
import ownership
from luce_geocore import geocore
from luce_geocore.geocore import Geometry, Vertex, Bounds

pub struct MeshGeometry: Geometry:
    let mesh: interop.Reference[geocore.Mesh]

    pub func init(mesh: interop.Reference[geocore.Mesh]):
        self.mesh = mesh.clone()

    pub func vertex_count() -> i64:
        return self.mesh.value().vertex_count()

    pub func index_count() -> i64:
        return self.mesh.value().index_count()

    pub func vertex(index: i64) -> interop.Outcome[Vertex]:
        return self.mesh.value().vertex(index)

    pub func index(offset: i64) -> interop.Outcome[i64]:
        return self.mesh.value().index(offset)

    pub func bounds() -> Bounds:
        return self.mesh.value().bounds()

    pub func close():
        self.mesh.release()

    func trace(visit: func(ownership.Object*, void*) -> unit, context: void*):
        self.mesh.trace(visit, context)

pub let mesh_geometry_type: interop.Type[MeshGeometry] = interop.Type[MeshGeometry]("MeshGeometry", MeshGeometry.close, MeshGeometry.trace, closeable = true)
