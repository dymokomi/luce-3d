\n    for (uint j = 0u; j < 16u; j++)\n    {\n        uint i = ((tile * 2048u) + (j * 128u)) + local;\n        if (i < count)\n        {\n            uint _98 = (((_83.keys[i] >> p.shift) & 15u) * 128u) + local;\n            table[_98]++;\n        }\n    }\n    threadgroup_barrier(mem_flags::mem_threadgroup);\n    uint digit = local >> 3u;\n    uint part = local & 7u;\n    uint sum = 0u;\n    for (uint k = 0u; k < 16u; k++)\n    {\n        sum += table[((digit * 128u) + (part * 16u)) + k];\n    }\n    partial[local] = sum;\n    threadgroup_barrier(mem_flags::mem_threadgroup);\n    if (local < 16u)\n    {\n        uint total = 0u;\n        for (uint k_1 = 0u; k_1 < 8u; k_1++)\n        {\n            total += partial[(local * 8u) + k_1];\n        }\n        _171.histogram[(local * tiles) + tile] = total;\n    }\n}\n\n"
