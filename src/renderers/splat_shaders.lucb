pub let splat_compact_comp_msl: c.str = "#pragma clang diagnostic ignored \"-Wmissing-prototypes\"\n#pragma clang diagnostic ignored \"-Wmissing-braces\"\n\n#include <metal_stdlib>\n#include <simd/simd.h>\n\nusing namespace metal;\n\ntemplate<typename T, size_t Num>\nstruct spvUnsafeArray\n{\n    T elements[Num ? Num : 1];\n    \n    thread T& operator [] (size_t pos) thread\n    {\n        return elements[pos];\n    }\n    constexpr const thread T& operator [] (size_t pos) const thread\n    {\n        return elements[pos];\n    }\n    \n    device T& operator [] (size_t pos) device\n    {\n        return elements[pos];\n    }\n    constexpr const device T& operator [] (size_t pos) const device\n    {\n        return elements[pos];\n    }\n    \n    constexpr const constant T& operator [] (size_t pos) const constant\n    {\n        return elements[pos];\n    }\n    \n    threadgroup T& operator [] (size_t pos) threadgroup\n    {\n        return elements[pos];\n    }\n    constexpr const threadgroup T& operator [] (size_t pos) const threadgroup\n    {\n        return elements[pos];\n    }\n};\n\nstruct Params\n{\n    float4 eye_near;\n    float4 right_far;\n    float4 up_fx;\n    float4 forward_fy;\n    float4 view;\n    uint4 counts;\n    float4 look;\n    float4 rotation;\n};\n\nstruct Depths\n{\n    uint depth_keys[1];\n};\n\nstruct Offsets\n{\n    uint group_offsets[1];\n};\n\nstruct Keys\n{\n    uint keys[1];\n};\n\nstruct Values\n{\n    uint values[1];\n};\n\nconstant uint3 gl_WorkGroupSize [[maybe_unused]] = uint3(256u, 1u, 1u);\n\nstatic inline __attribute__((always_inline))\nuint splat_index(thread uint3& gl_WorkGroupID, thread uint3& gl_NumWorkGroups, thread uint3& gl_LocalInvocationID)\n{\n    uint group = (gl_WorkGroupID.y * gl_NumWorkGroups.x) + gl_WorkGroupID.x;\n    return (group * 256u) + gl_LocalInvocationID.x;\n}\n\nstatic inline __attribute__((always_inline))\nuint group_index(thread uint3& gl_WorkGroupID, thread uint3& gl_NumWorkGroups)\n{\n    return (gl_WorkGroupID.y * gl_NumWorkGroups.x) + gl_WorkGroupID.x;\n}\n\nkernel void luce_compute(constant Params& p [[buffer(30)]], device Depths& _74 [[buffer(0)]], device Offsets& _130 [[buffer(1)]], device Keys& _142 [[buffer(2)]], device Values& _149 [[buffer(3)]], uint3 gl_WorkGroupID [[threadgroup_position_in_grid]], uint3 gl_NumWorkGroups [[threadgroups_per_grid]], uint3 gl_LocalInvocationID [[thread_position_in_threadgroup]])\n{\n    threadgroup spvUnsafeArray<uint, 256> ranks;\n    uint local = gl_LocalInvocationID.x;\n    uint i = splat_index(gl_WorkGroupID, gl_NumWorkGroups, gl_LocalInvocationID);\n    uint key = 4294967295u;\n    if (i < p.counts.x)\n    {\n        key = _74.depth_keys[i];\n    }\n    bool visible = key != 4294967295u;\n    ranks[local] = uint(visible);\n    threadgroup_barrier(mem_flags::mem_threadgroup);\n    for (uint _step = 1u; _step < 256u; _step = _step << 1u)\n    {\n        uint value = ranks[local];\n        if (local >= _step)\n        {\n            value += ranks[local - _step];\n        }\n        threadgroup_barrier(mem_flags::mem_threadgroup);\n        ranks[local] = value;\n        threadgroup_barrier(mem_flags::mem_threadgroup);\n    }\n    if (visible)\n    {\n        uint at = (_130.group_offsets[group_index(gl_WorkGroupID, gl_NumWorkGroups)] + ranks[local]) - 1u;\n        _142.keys[at] = key;\n        _149.values[at] = i;\n    }\n}\n\n"
