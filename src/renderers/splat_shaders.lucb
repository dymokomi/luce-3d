pub let splat_frag_msl: c.str = "#include <metal_stdlib>\n#include <simd/simd.h>\n\nusing namespace metal;\n\nstruct Params\n{\n    float cull;\n};\n\nstruct luce_fragment_out\n{\n    float4 fragment_color [[color(0)]];\n};\n\nstruct luce_fragment_in\n{\n    float4 vertex_color [[user(locn0)]];\n    float4 data0 [[user(locn1), flat]];\n};\n\nfragment luce_fragment_out luce_fragment(luce_fragment_in in [[stage_in]], constant Params& params [[buffer(0)]])\n{\n    luce_fragment_out out = {};\n    float2 uv = in.vertex_color.xy;\n    float r2 = dot(uv, uv);\n    if (r2 > 1.0)\n    {\n        discard_fragment();\n    }\n    float opacity = in.data0.w;\n    if (opacity > 1.5)\n    {\n        out.fragment_color = float4(in.data0.xyz, 1.0);\n        return out;\n    }\n    float alpha;\n    if (opacity < 0.0)\n    {\n        alpha = fast::min(0.9900000095367431640625, 1.0 - exp(opacity * exp((-4.5) * r2)));\n    }\n    else\n    {\n        float k2 = fast::min(2.0 * log(opacity / params.cull), 9.0);\n        alpha = fast::min(0.9900000095367431640625, opacity * exp(((-0.5) * k2) * r2));\n    }\n    if (alpha < params.cull)\n    {\n        discard_fragment();\n    }\n    out.fragment_color = float4(in.data0.xyz * alpha, alpha);\n    return out;\n}\n\n"
pub let splat_frag_fast_math: bool = true

