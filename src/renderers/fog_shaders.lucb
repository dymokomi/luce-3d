pub let fog_frag_msl: c.str = "#pragma clang diagnostic ignored \"-Wmissing-prototypes\"\n\n#include <metal_stdlib>\n#include <simd/simd.h>\n\nusing namespace metal;\n\n// Implementation of the GLSL mod() function, which is slightly different than Metal fmod()\ntemplate<typename Tx, typename Ty>\ninline Tx mod(Tx x, Ty y)\n{\n    return x - y * floor(x / y);\n}\n\nstruct Params\n{\n    float4 eye;\n    float4 forward;\n    float4 scale;\n    float4 key;\n    float4 smoke;\n    float4 glow;\n    float4 atlas;\n    float4 size;\n};\n\nstruct luce_fragment_out\n{\n    float4 fragment_color [[color(0)]];\n};\n\nstruct luce_fragment_in\n{\n    float4 vertex_color [[user(locn0)]];\n};\n\nstatic inline __attribute__((always_inline))\nfloat jitter(thread const float2& pixel)\n{\n    return fract(52.98291778564453125 * fract(dot(pixel, float2(0.067110560834407806396484375, 0.005837149918079376220703125))));\n}\n\nstatic inline __attribute__((always_inline))\nfloat4 texels(thread const float3& q, constant Params& params, texture2d<float> volume, sampler volumeSmplr)\n{\n    float3 t = (q * params.atlas.xyz) - float3(0.5);\n    float2 xy = fast::clamp(t.xy, float2(0.0), params.atlas.xy - float2(1.0)) + float2(0.5);\n    float z = fast::clamp(t.z, 0.0, params.atlas.z - 1.0);\n    float z0 = floor(z);\n    float z1 = fast::min(z0 + 1.0, params.atlas.z - 1.0);\n    float columns = params.atlas.w;\n    float2 tile0 = float2(mod(z0, columns), floor(z0 / columns)) * params.atlas.xy;\n    float2 tile1 = float2(mod(z1, columns), floor(z1 / columns)) * params.atlas.xy;\n    float4 a = volume.sample(volumeSmplr, ((tile0 + xy) / params.size.xy), level(0.0));\n    float4 b = volume.sample(volumeSmplr, ((tile1 + xy) / params.size.xy), level(0.0));\n    return mix(a, b, float4(z - z0));\n}\n\nfragment luce_fragment_out luce_fragment(luce_fragment_in in [[stage_in]], constant Params& params [[buffer(0)]], texture2d<float> volume [[texture(1)]], sampler volumeSmplr [[sampler(1)]], float4 gl_FragCoord [[position]])\n{\n    luce_fragment_out out = {};\n    float3 start = in.vertex_color.xyz;\n    float3 ray = start - params.eye.xyz;\n    float depth = dot(ray, params.forward.xyz);\n    if (depth <= 0.0)\n    {\n        discard_fragment();\n    }\n    float steps = params.forward.w;\n    float ds = (params.eye.w / depth) / steps;\n    float span = length(ray * params.scale.xyz);\n    float step_length = span * ds;\n    float density_scale = params.scale.w;\n    float shadow_scale = params.smoke.w * density_scale;\n    float3 key = params.key.xyz;\n    float ambient = params.key.w;\n    float3 radiance = float3(0.0);\n    float transmittance = 1.0;\n    float2 param = gl_FragCoord.xy;\n    float offset = jitter(param);\n    for (float i = 0.0; i < steps; i += 1.0)\n    {\n        float3 q = params.eye.xyz + (ray * (1.0 + ((i + offset) * ds)));\n        bool _244 = any(q < float3(0.0));\n        bool _252;\n        if (!_244)\n        {\n            _252 = any(q > float3(1.0));\n        }\n        else\n        {\n            _252 = _244;\n        }\n        if (_252)\n        {\n            continue;\n        }\n        float3 param_1 = q;\n        float4 s = texels(param_1, params, volume, volumeSmplr);\n        float sigma = s.x * density_scale;\n        float3 emitted = params.glow.xyz * fast::max(s.w, 0.0);\n        if ((sigma <= 0.0) && all(emitted == float3(0.0)))\n        {\n            continue;\n        }\n        float alpha = 1.0 - exp((-sigma) * step_length);\n        float3 lit = params.smoke.xyz * ((key * exp((-s.y) * shadow_scale)) + float3(ambient * exp((-s.z) * density_scale)));\n        radiance += (((lit * alpha) + (emitted * step_length)) * transmittance);\n        transmittance *= (1.0 - alpha);\n    }\n    float coverage = 1.0 - transmittance;\n    if ((coverage <= 0.0) && all(radiance == float3(0.0)))\n    {\n        discard_fragment();\n    }\n    out.fragment_color = float4(radiance, coverage);\n    return out;\n}\n\n"
pub let fog_frag_fast_math: bool = true
