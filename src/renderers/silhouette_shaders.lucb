pub let silhouette_frag_msl: c.str = "#pragma clang diagnostic ignored \"-Wmissing-prototypes\"\n\n#include <metal_stdlib>\n#include <simd/simd.h>\n\nusing namespace metal;\n\nstruct Params\n{\n    float4 view;\n    float4 stroke;\n};\n\nstruct luce_fragment_out\n{\n    float4 fragment_color [[color(0)]];\n};\n\nstruct luce_fragment_in\n{\n    float4 vertex_color [[user(locn0)]];\n};\n\nstatic inline __attribute__((always_inline))\nfloat covered(thread const float2& uv, constant Params& p, texture2d<float> coverage, sampler coverageSmplr)\n{\n    bool _19 = any(uv < float2(0.0));\n    bool _28;\n    if (!_19)\n    {\n        _28 = any(uv > float2(1.0));\n    }\n    else\n    {\n        _28 = _19;\n    }\n    if (_28)\n    {\n        return 0.0;\n    }\n    return smoothstep(p.stroke.w - 0.02999999932944774627685546875, p.stroke.w + 0.02999999932944774627685546875, coverage.sample(coverageSmplr, uv).w);\n}\n\nfragment luce_fragment_out luce_fragment(luce_fragment_in in [[stage_in]], constant Params& p [[buffer(0)]], texture2d<float> coverage [[texture(1)]], sampler coverageSmplr [[sampler(1)]], float4 gl_FragCoord [[position]])\n{\n    luce_fragment_out out = {};\n    float2 uv = (gl_FragCoord.xy - p.view.xy) / p.view.zw;\n    float2 param = uv;\n    float center = covered(param, p, coverage, coverageSmplr);\n    float around = center;\n    for (int y = -4; y <= 4; y++)\n    {\n        for (int x = -4; x <= 4; x++)\n        {\n            float2 offset = float2(float(x), float(y));\n            float weight = fast::clamp((p.stroke.z + 0.5) - length(offset), 0.0, 1.0);\n            if (weight > 0.0)\n            {\n                float2 param_1 = uv + (offset * p.stroke.xy);\n                around = fast::max(around, covered(param_1, p, coverage, coverageSmplr) * weight);\n            }\n        }\n    }\n    float alpha = fast::max(0.0, around - center) * in.vertex_color.w;\n    out.fragment_color = float4(in.vertex_color.xyz * alpha, alpha);\n    return out;\n}\n\n"
