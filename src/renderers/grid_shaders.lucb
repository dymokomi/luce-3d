pub let grid_frag_msl: c.str = "#pragma clang diagnostic ignored \"-Wmissing-prototypes\"\n\n#include <metal_stdlib>\n#include <simd/simd.h>\n\nusing namespace metal;\n\nstruct Params\n{\n    float4 view;\n    float4 eye;\n    float4 right;\n    float4 up;\n    float4 forward;\n    float4 major;\n    float4 minor;\n};\n\nstruct luce_fragment_out\n{\n    float4 fragment_color [[color(0)]];\n};\n\nstruct luce_fragment_in\n{\n    float4 vertex_color [[user(locn0)]];\n};\n\nstatic inline __attribute__((always_inline))\nfloat2 coverage(thread const float2& at, thread const float2& footprint, thread const float& spacing, thread float2& apart, constant Params& p)\n{\n    apart = float2(spacing) / fast::max(footprint, float2(9.9999996826552253889678874634872e-21));\n    float2 offset = abs(fract((at / float2(spacing)) + float2(0.5)) - float2(0.5)) * apart;\n    float half_width = 0.5 * p.up.w;\n    return fast::clamp(float2(half_width + 0.5) - offset, float2(0.0), float2(1.0));\n}\n\nfragment luce_fragment_out luce_fragment(luce_fragment_in in [[stage_in]], constant Params& p [[buffer(0)]], float4 gl_FragCoord [[position]])\n{\n    luce_fragment_out out = {};\n    float2 uv = (gl_FragCoord.xy - p.view.xy) / p.view.zw;\n    float2 ndc = float2((uv.x * 2.0) - 1.0, 1.0 - (uv.y * 2.0));\n    float3 ray = (p.forward.xyz + (p.right.xyz * ndc.x)) + (p.up.xyz * ndc.y);\n    float t = (p.forward.w - p.eye.y) / ray.y;\n    if (!(t > 0.0))\n    {\n        discard_fragment();\n    }\n    float3 hit = p.eye.xyz + (ray * t);\n    float2 at = hit.xz;\n    float2 footprint = fwidth(at);\n    float widest = fast::max(footprint.x, footprint.y);\n    float finest = p.right.w;\n    float level0 = floor(log(fast::max((2.0 * widest) / finest, 9.9999999747524270787835121154785e-07)) / 1.6094379425048828125);\n    float spacing = finest * powr(5.0, level0);\n    float3 color = float3(0.0);\n    float alpha = 0.0;\n    float2 param_3;\n    for (int index = 0; index < 4; index++)\n    {\n        float2 param = at;\n        float2 param_1 = footprint;\n        float param_2 = spacing;\n        float2 _191 = coverage(param, param_1, param_2, param_3, p);\n        float2 apart = param_3;\n        float2 lines = _191;\n        float2 shown = smoothstep(float2(6.0), float2(20.0), apart);\n        float2 strength = lines * shown;\n        float a = fast::max(strength.x, strength.y);\n        float bright = smoothstep(20.0, 100.0, fast::min(apart.x, apart.y));\n        float3 tone = mix(p.minor.xyz, p.major.xyz, float3(bright));\n        float opacity = mix(p.minor.w, p.major.w, bright) * a;\n        if (opacity > alpha)\n        {\n            alpha = opacity;\n            color = tone;\n        }\n        spacing *= 5.0;\n    }\n    float2 axis_offset = abs(at) / fast::max(footprint, float2(9.9999996826552253889678874634872e-21));\n    float2 axes = fast::clamp(float2(((0.5 * p.up.w) * 1.5) + 0.5) - axis_offset.yx, float2(0.0), float2(1.0));\n    float axis = fast::max(axes.x, axes.y) * in.vertex_color.w;\n    if (axis > 0.0)\n    {\n        color = mix(color, in.vertex_color.xyz, float3(axis));\n        alpha = fast::max(alpha, axis);\n    }\n    float _distance = length(hit.xz - p.eye.xz);\n    float far_fade = 1.0 - smoothstep(0.25 * p.eye.w, p.eye.w, _distance);\n    float edge_on = abs(ray.y) / length(ray);\n    float horizon = smoothstep(0.0, 0.07999999821186065673828125, edge_on);\n    alpha *= (far_fade * horizon);\n    if (alpha <= 0.00200000009499490261077880859375)\n    {\n        discard_fragment();\n    }\n    out.fragment_color = float4(color * alpha, alpha);\n    return out;\n}\n\n"
