## Bounded temporary topology with explicit output-to-input provenance.
import interop
import memory
import luce_3d.errors as errors
from luce_3d.math.vector import Vector3
from luce_3d.geometries.polygon import PolygonMesh, polygon_mesh_type

pub struct MeshBuilder:
    pub var points: Vector3[]
    pub var sizes: i64[]
    pub var corners: i64[]
    pub var point_parents: i64[]
    pub var face_parents: i64[]
    pub var corner_parents: i64[]
    pub var np: usize
    pub var nf: usize
    pub var nc: usize

    pub func init() -> !:
        let p = try alloc Vector3[256] in memory.heap
        errdefer free(p) in memory.heap
        let s = try alloc i64[256] in memory.heap
        errdefer free(s) in memory.heap
        let c = try alloc i64[1024] in memory.heap
        errdefer free(c) in memory.heap
        let pp = try alloc i64[256] in memory.heap
        errdefer free(pp) in memory.heap
        let fp = try alloc i64[256] in memory.heap
        errdefer free(fp) in memory.heap
        let cp = try alloc i64[1024] in memory.heap
        self.points = p
        self.sizes = s
        self.corners = c
        self.point_parents = pp
        self.face_parents = fp
        self.corner_parents = cp
        self.np = 0
        self.nf = 0
        self.nc = 0

    pub mutating func point(position: Vector3, parent: i64 = -1) -> i64!:
        if self.np == self.points.length:
            try grow[Vector3](&self.points, 8388608)
        if self.np == self.point_parents.length:
            try grow[i64](&self.point_parents, 8388608)
        let id = self.np
        self.points[id] = position
        self.point_parents[id] = parent
        self.np += 1
        return (i64)id

    pub mutating func face(count: i64, parent: i64 = -1) -> !:
        if count < 3 or count > 256:
            error(errors.limit, "operation exceeds face/corner limits")
        if self.nf == self.sizes.length:
            try grow[i64](&self.sizes, 8388608)
        if self.nf == self.face_parents.length:
            try grow[i64](&self.face_parents, 8388608)
        self.sizes[self.nf] = count
        self.face_parents[self.nf] = parent
        self.nf += 1

    pub mutating func corner(point: i64, parent: i64 = -1) -> !:
        if self.nc == self.corners.length:
            try grow[i64](&self.corners, 33554432)
        if self.nc == self.corner_parents.length:
            try grow[i64](&self.corner_parents, 33554432)
        self.corners[self.nc] = point
        self.corner_parents[self.nc] = parent
        self.nc += 1

    pub mutating func copy_points(mesh: const PolygonMesh*) -> !:
        for id in 0..<mesh.point_count():
            discard(try self.point(try mesh.point(id), id))

    pub mutating func copy_face(mesh: const PolygonMesh*, id: i64) -> !:
        let count = try mesh.face_size(id)
        let offset = try mesh.face_offset(id)
        try self.face(count, id)
        for at in 0..<count:
            try self.corner(try mesh.face_point(id, at), offset + at)

    pub func finish(source: const PolygonMesh*? = none) -> interop.Reference[PolygonMesh]!:
        if let original = source:
            return try original.remapped(self.points[..<self.np], self.sizes[..<self.nf], self.corners[..<self.nc], self.point_parents[..<self.np], self.face_parents[..<self.nf], self.corner_parents[..<self.nc])
        return try interop.Reference[PolygonMesh].adopt(new PolygonMesh(self.points[..<self.np], self.sizes[..<self.nf], self.corners[..<self.nc]) in memory.heap, polygon_mesh_type, memory.heap)

    pub mutating func close():
        free(self.points) in memory.heap
        free(self.sizes) in memory.heap
        free(self.corners) in memory.heap
        free(self.point_parents) in memory.heap
        free(self.face_parents) in memory.heap
        free(self.corner_parents) in memory.heap

## Geometric growth keeps small operations small; the hard budget bounds runaway
## subdivision. Callers must not retain spans across point/face/corner appends.
func grow[T](values: T[]*, limit: usize) -> !:
    if values.length >= limit:
        error(errors.limit, "mesh exceeds the 8M point/face or 32M corner safety budget")
    let replacement = try alloc T[values.length * 2] in memory.heap
    for index in 0..<values.length:
        replacement[index] = (*values)[index]
    free(*values) in memory.heap
    *values = replacement

pub func selection_mask(selection: const i64[], count: i64) -> bool[]!:
    let result = try alloc bool[(usize)count] in memory.heap
    errdefer free(result) in memory.heap
    for index in 0..<result.length:
        result[index] = false
    for index in selection:
        if index < 0 or index >= count:
            error(errors.invalid, "selected component no longer exists")
        result[(usize)index] = true
    return result
