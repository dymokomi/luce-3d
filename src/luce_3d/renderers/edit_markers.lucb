## Depth-tested point markers for Edit mode, thinned to one per marker-sized
## screen cell. Visibility comes from the depth buffer, not a ray per point.
import gpu
import math
from luce_3d.cameras.perspective import Projection
from geocore_growing import Growing
from luce_3d.renderers.edit_screen import Screen

let cell: f64 = 6.0

## Depth-tested square markers, at most one ordinary and one selected marker
## per screen cell (the nearest point wins). Rebuilt when the camera or the
## selection changes; the hovered marker is drawn on its own.
pub struct Markers:
    var vertices: Growing[gpu.Vertex]
    var nearest: Growing[i64]
    var version: u64 = 0
    var valid: bool = false

    pub func init():
        self.vertices = Growing[gpu.Vertex]()
        self.nearest = Growing[i64]()
        self.version = 0
        self.valid = false

    pub mutating func invalidate():
        self.valid = false

    pub mutating func draw(target: const gpu.RenderTarget*, screen: const Screen*, selected: const bool[], hovered: i64,
                           p: Projection, width: f64, height: f64, ordinary: gpu.Color, accent: gpu.Color) -> !:
        if not self.valid or self.version != screen.version:
            self.vertices.clear()
            # Selected markers first: at equal depth the first one drawn wins.
            for round in 0..<(usize)2:
                try self.nearest_per_cell(screen, selected, round == 0, width, height)
                for id in self.nearest.view():
                    if id >= 0: try self.quad(screen, (usize)id, 3.0, p, width, height, accent if round == 0 else ordinary)
            self.version = screen.version
            self.valid = true
        let count = self.vertices.count
        if hovered >= 0 and (usize)hovered < screen.depths.count and screen.depths.items[(usize)hovered] > 0.0:
            try self.quad(screen, (usize)hovered, 4.5, p, width, height, accent)
        if self.vertices.count > 0:
            try target.allow_vertices(8388608)
            try target.triangles(self.vertices.view(), true)
        self.vertices.count = count

    mutating func nearest_per_cell(screen: const Screen*, selected: const bool[], chosen: bool, width: f64, height: f64) -> !:
        let columns = (usize)math.ceil(width / cell)
        let rows = (usize)math.ceil(height / cell)
        try self.nearest.fill(columns * rows, -1)
        for id in 0..<screen.depths.count:
            let depth = screen.depths.items[id]
            if depth <= 0.0 or selected[id] != chosen: continue
            let x = (f64)screen.xs.items[id]
            let y = (f64)screen.ys.items[id]
            if x < 0.0 or y < 0.0 or x >= width or y >= height: continue
            let slot = (usize)(y / cell) * columns + (usize)(x / cell)
            let other = self.nearest.items[slot]
            if other < 0 or screen.depths.items[(usize)other] > depth:
                self.nearest.items[slot] = (i64)id

    mutating func quad(screen: const Screen*, id: usize, radius: f64, p: Projection, width: f64, height: f64, color: gpu.Color) -> !:
        let w = (f64)screen.depths.items[id]
        let x = ((f64)screen.xs.items[id] / (width * 0.5) - 1.0) * w
        let y = (1.0 - (f64)screen.ys.items[id] / (height * 0.5)) * w
        # Pull the marker toward the eye by twice its own world size so the
        # surface it sits on does not clip it.
        let z = p.far * (w - p.near) / (p.far - p.near) - 4.0 * radius * p.far * p.near / (p.focal * height * (p.far - p.near))
        let rx = radius * 2.0 / width * w
        let ry = radius * 2.0 / height * w
        let corners: f64[12] = [-rx, -ry, rx, -ry, rx, ry, -rx, -ry, rx, ry, -rx, ry]
        for at in 0..<(usize)6:
            try self.vertices.push(gpu.Vertex(x = (f32)(x + corners[at * 2]), y = (f32)(y + corners[at * 2 + 1]), z = (f32)z, w = (f32)w,
                                              red = (f32)color.red, green = (f32)color.green, blue = (f32)color.blue))

    pub mutating func close():
        self.vertices.close()
        self.nearest.close()
