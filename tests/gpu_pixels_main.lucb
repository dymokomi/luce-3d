## Independent Metal readback checks depth, clipping and the UI's viewport scope.
import gpu
import interop
import memory
import window
import native
import three
import three_ui
import ui
from three import Scene, Mesh, BufferGeometry, Geometry, Material, Object3D, Vertex, Vector3, Color, MeshBasicMaterial, PerspectiveCamera, Renderer
from three_ui import SceneView
from ui import Application, Widget, HStack, Alignment

func rendered(result: interop.Outcome[unit]) -> !:
    defer result.release()
    try result.get()

func object_mesh(shape: interop.Reference[BufferGeometry], color: Color) -> interop.Reference[Mesh]!:
    let geometry = shape.as_interface[Geometry](shape.value())
    defer geometry.release()
    let material = try interop.Reference[MeshBasicMaterial].adopt(new MeshBasicMaterial(color) in memory.heap, three.basic_material_type, memory.heap)
    defer material.release()
    let appearance = material.as_interface[Material](material.value())
    defer appearance.release()
    return try interop.Reference[Mesh].adopt(new Mesh(geometry, appearance) in memory.heap, three.mesh_type, memory.heap)

func frame(scene: interop.Interface[Object3D], camera: interop.Reference[PerspectiveCamera],
           renderer: interop.Reference[Renderer], host: window.Window, surface: gpu.Surface, blue: bool) -> !:
    while let event = try host.poll():
        discard(event)
    native.begin("3D pixel contracts")
    defer native.end()
    let recording = try surface.frame()
    defer recording.release()
    let target = try recording.value().target()
    defer target.release()
    try rendered(renderer.value().render(scene, camera, target, true))
    discard(try recording.value().present())
    try surface.wait_idle()
    let size = try host.size()
    native.pixel((u64)(size.width * size.scale / 2.0), (u64)(size.height * size.scale / 2.0),
                 0 if blue else 255, 0, 255 if blue else 0)
    native.pixel(0, 0, 0, 0, 0)

pub func main(arguments: str[]) -> i32!:
    let pool = native.pool()
    defer native.drain(pool)
    let vertices = [Vertex(Vector3(-1.0, -1.0, 0.0), Vector3(0.0, 0.0, 1.0)),
                    Vertex(Vector3(1.0, -1.0, 0.0), Vector3(0.0, 0.0, 1.0)),
                    Vertex(Vector3(0.0, 1.0, 0.0), Vector3(0.0, 0.0, 1.0))]
    let shape = try interop.Reference[BufferGeometry].adopt(new BufferGeometry(vertices, [(i64)0, 1, 2]) in memory.heap, three.buffer_geometry_type, memory.heap)
    defer shape.release()
    let red = try object_mesh(shape, Color(1.0, 0.0, 0.0))
    defer red.release()
    let blue = try object_mesh(shape, Color(0.0, 0.0, 1.0))
    defer blue.release()
    let red_object = red.as_interface[Object3D](red.value())
    defer red_object.release()
    let blue_object = blue.as_interface[Object3D](blue.value())
    defer blue_object.release()
    let scene = try interop.Reference[Scene].adopt(new Scene() in memory.heap, three.scene_type, memory.heap)
    defer scene.release()
    let scene_object = scene.as_interface[Object3D](scene.value())
    defer scene_object.release()
    try blue.value().set_position(Vector3(0.0, 0.0, 1.0))
    try scene.value().add(blue_object)
    try scene.value().add(red_object)
    let camera = try interop.Reference[PerspectiveCamera].adopt(new PerspectiveCamera(50.0, 1.0, 1.0, 100.0) in memory.heap, three.perspective_camera_type, memory.heap)
    defer camera.release()
    let renderer = try interop.Reference[Renderer].adopt(new Renderer() in memory.heap, three.renderer_type, memory.heap)
    defer renderer.release()
    var host = try window.Window.open(window.Options(title = "3D pixel contracts", width = 160, height = 100))
    defer host.destroy()
    var device = try gpu.Device.open()
    defer device.destroy()
    var surface = try gpu.Surface.open(device, host)
    defer surface.destroy()
    try host.show()
    try frame(scene_object, camera, renderer, host, surface, true)
    # Submission order cannot replace the nearer triangle with the farther one.
    assert(try scene.value().remove(blue_object))
    try scene.value().add(blue_object)
    try frame(scene_object, camera, renderer, host, surface, true)
    try blue.value().set_position(Vector3(0.0, 0.0, 4.5))
    try frame(scene_object, camera, renderer, host, surface, false)
    try blue.value().set_position(Vector3(0.0, 0.0, 6.0))
    try frame(scene_object, camera, renderer, host, surface, false)
    try blue.value().set_position(Vector3(0.0, 0.0, 1.0))
    try host.resize(200, 120)
    try frame(scene_object, camera, renderer, host, surface, true)

    let view = try interop.Reference[SceneView].adopt(new SceneView(scene_object, camera, renderer, 64.0, 64.0) in memory.heap, three_ui.scene_view_type, memory.heap)
    defer view.release()
    let box = view.value().layout()
    defer box.release()
    try box.value().set_size(64.0, 64.0)
    let widget = view.as_interface[Widget](view.value())
    defer widget.release()
    let row = try interop.Reference[HStack].adopt(new HStack([widget], 8.0, 8.0, Alignment.start) in memory.heap, ui.hstack_type, memory.heap)
    defer row.release()
    let root = row.as_interface[Widget](row.value())
    defer root.release()
    let app = try interop.Reference[Application].adopt(new Application(root) in memory.heap, ui.application_type, memory.heap)
    defer app.release()
    native.begin("3D pixel contracts")
    defer native.end()
    let recording = try surface.frame()
    defer recording.release()
    let target = try recording.value().target()
    defer target.release()
    try rendered(app.value().render(target))
    discard(try recording.value().present())
    try surface.wait_idle()
    let size = try host.size()
    native.pixel((u64)(40.0 * size.scale), (u64)(40.0 * size.scale), 0, 0, 255)
    native.pixel((u64)(4.0 * size.scale), (u64)(40.0 * size.scale), 0, 0, 0)
    native.pixel((u64)(76.0 * size.scale), (u64)(40.0 * size.scale), 0, 0, 0)
    assert(camera.value().aspect() == 1.0)
    print("ok 3D Metal depth, near-plane/behind-camera clipping, resize and UI composition")
    return 0
