from three import Scene, Group, Mesh, SphereGeometry, MeshLambertMaterial, Color, Vector3, PerspectiveCamera, AmbientLight, DirectionalLight, Renderer
from three_ui import SceneView
from ui import Application
from gpu import Frame
import window

pub func main(arguments: list[str]) -> int!:
    let geometry = SphereGeometry(1.0, 16, 8)
    let material = MeshLambertMaterial(Color(0.1, 0.4, 1.0))
    let mesh = Mesh(geometry, material)
    mesh.set_position(Vector3(0.2, 0.0, 0.0))
    mesh.set_rotation(Vector3(0.1, 0.2, 0.0))
    let group = Group()
    group.set_scale(Vector3(1.0, 0.8, 1.2))
    group.add(mesh)
    let scene = Scene()
    scene.add(group)
    scene.add(AmbientLight(intensity = 0.2))
    scene.add(DirectionalLight(intensity = 0.8))
    let camera = PerspectiveCamera(50.0, 1.0, 0.1, 100.0)
    let renderer = Renderer()
    let frame = Frame(window.Size(200.0, 160.0, 200.0, 160.0, 1.0))
    let target = frame.target()
    renderer.render(scene, camera, target)
    let view = SceneView(scene, camera, renderer, width = 80.0, height = 60.0)
    let app = Application(view)
    app.render(target)
    assert(camera.aspect() == 1.0)
    assert(group.remove(mesh))
    scene.add(mesh)
    assert(group.node().child_count() == 0 and scene.node().child_count() == 4)
    frame.close()
    print("ok Luce scene objects and UI composition")
    return 0
